OBJECT = COMPRESSED_FILE
    FILE_NAME                  = "ESP_069665_2055_COLOR.JP2"
    RECORD_TYPE                = UNDEFINED
    ENCODING_TYPE              = "JP2"
    ENCODING_TYPE_VERSION_NAME = "ISO/IEC15444-1:2004"
