    MRO:CCD_FLAG                = (ON, ON, ON, ON, ON, ON, ON, ON, ON, OFF,
                                  ON, ON, ON, ON)
    MRO:BINNING                 = (-9998, -9998, -9998, -9998, 1, 1, -9998,
